<?xml version="1.0" encoding="UTF-8" ?>
<MidiOptions>
  <!-- Quantization: 0=1/4, 1=1/8, 2=1/16, 3=1/32, 4=1/64. -->
  <QuantValue>3</QuantValue>
  <!-- value + 1; 3 means four independent voices. -->
  <VoiceCount>3</VoiceCount>
  <Duplets>true</Duplets>
  <Triplets>true</Triplets>
  <Quadruplets>true</Quadruplets>
  <!-- 48 TPQ can represent binary durations and 3:2 tuplets exactly. -->
  <!-- 5:4, 7:4 and 9:8 tuplets are disabled: the Score normalizer must
       reject their non-integral tick values instead of silently rounding. -->
  <Quintuplets>false</Quintuplets>
  <Septuplets>false</Septuplets>
  <Nonuplets>false</Nonuplets>
  <!-- Preserve source beat positions for monophonic GAME vocals; simplify
       durations to the exact 48 TPQ score grid. -->
  <HumanPerformance>false</HumanPerformance>
  <MeasureCount2xLess>false</MeasureCount2xLess>
  <SplitStaff>true</SplitStaff>
  <ClefChanges>true</ClefChanges>
  <SimplifyDurations>true</SimplifyDurations>
  <ShowStaccato>true</ShowStaccato>
  <DottedNotes>true</DottedNotes>
  <RecognizePickupBar>true</RecognizePickupBar>
  <Swing>0</Swing>
</MidiOptions>
